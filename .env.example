# Supabase — FREE & SECURE (Auth + Postgres + Realtime)
# 1) Create FREE project at https://supabase.com/dashboard → New project
# 2) Project Settings → API → copy Project URL + anon public key
# 3) Set same keys in GitHub → Settings → Secrets and variables → Actions → New repository secret (for deploy)
# Leave empty to run in local/GitHub-only mode (no instant sync). Supabase is FREE, no card required.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: override legacy local password (still need Supabase Auth for global writes when Supabase enabled)
# Default legacy is admin2026 if not set
VITE_ADMIN_PASSWORD=

# GitHub backup publish (optional, stored in browser localStorage, not env)
# Create classic PAT with repo scope at https://github.com/settings/tokens/new
# Stored as localStorage github_pat after you paste in Admin → Settings
