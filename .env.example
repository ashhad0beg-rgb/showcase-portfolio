# Super-safe Firebase config — enables instant global sync (<2s) with auth-gated writes
# 1) Firebase Console → Project Settings → General → Your apps → Web app → Copy config
# 2) Fill below, set same keys in GitHub → Settings → Secrets and variables → Actions → New repository secret
# Leave empty to run in local/GitHub-only mode (no instant sync)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override legacy local password (still need Firebase Auth for global writes when Firebase enabled)
# Default legacy is admin2026 if not set
VITE_ADMIN_PASSWORD=

# GitHub backup publish (optional, stored in browser localStorage, not env)
# Create classic PAT with repo scope at https://github.com/settings/tokens/new
# Stored as localStorage github_pat after you paste in Admin → Settings
