rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Portfolio live data — super-safe: public read, authenticated write only
    match /portfolio/live {
      allow read: if true;
      // Only Firebase Auth users can write — prevents visitors / bots from overwriting
      // For extra lockdown, restrict to specific admin email:
      // allow write: if request.auth != null && request.auth.token.email == "your-admin@example.com";
      allow write: if request.auth != null
                   && request.resource.data._version is int
                   && request.resource.data._version > 0
                   && request.resource.data._version < 1000000
                   // Enforce payload size (< 400KB) and basic shape
                   && request.resource.data.hero is map
                   && request.resource.data.work is list;

      // History subcollection — same auth gate, immutable append-only
      match /history/{historyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false; // never mutate history
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
